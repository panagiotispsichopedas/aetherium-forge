<?xml version="1.0" encoding="utf-8"?>
<!--
  Code coverage settings for CI, passed to dotnet test with the coverage-settings option.
  Avalonia's compiled XAML generates helper types and members whose names contain U+0001; the Cobertura
  XML writer cannot write those and crashes the test host. They are generated code, so they are excluded.
  Note: XML comments cannot contain two hyphens in a row.
-->
<Configuration>
  <CodeCoverage>
    <Functions>
      <Exclude>
        <Function>^CompiledAvaloniaXaml\..*</Function>
        <Function>.*\x01.*</Function>
        <Function>.*XamlIl.*</Function>
      </Exclude>
    </Functions>
    <Attributes>
      <Exclude>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
      </Exclude>
    </Attributes>
  </CodeCoverage>
</Configuration>
