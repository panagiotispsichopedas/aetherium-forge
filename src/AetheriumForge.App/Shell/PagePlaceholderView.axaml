<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:AetheriumForge.App.Shell"
             x:Class="AetheriumForge.App.Shell.PagePlaceholderView"
             x:DataType="shell:PagePlaceholderViewModel">
  <StackPanel Spacing="8">
    <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
    <TextBlock Text="Coming in M4." Opacity="0.7" />
  </StackPanel>
</UserControl>
