<Project Sdk="Microsoft.NET.Sdk">

  <!-- Avalonia desktop UI (IMPLEMENTATION_GUIDE §14). MVVM with CommunityToolkit.Mvvm; services from Core through DI. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>AetheriumForge.App</RootNamespace>
    <AssemblyName>AetheriumForge</AssemblyName>
    <ApplicationIcon>..\..\assets\icon\aetherium-forge.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AetheriumForge.Core\AetheriumForge.Core.csproj" />
    <ProjectReference Include="..\AetheriumForge.Native\AetheriumForge.Native.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\icon\aetherium-forge.ico" Link="Assets\aetherium-forge.ico" />
    <AvaloniaResource Include="..\..\assets\icon\aetherium-forge-256.png" Link="Assets\aetherium-forge-256.png" />
  </ItemGroup>

  <!-- Ship texconv next to the exe (tools\texconv.exe) when it has been fetched with tools\fetch-tools.ps1. It is never committed. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\tools\texconv.exe')">
    <None Include="$(MSBuildThisFileDirectory)..\..\tools\texconv.exe" Link="tools\texconv.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AetheriumForge.Core.Tests" />
  </ItemGroup>

</Project>
