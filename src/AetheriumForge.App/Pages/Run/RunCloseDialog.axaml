<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AetheriumForge.App.Pages.Run.RunCloseDialog"
        Title="A run is active"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="20" Spacing="16">
    <StackPanel x:Name="ChoicePanel" Spacing="16">
      <TextBlock TextWrapping="Wrap"
                 Text="The pipeline is still running. Pause and close keeps the queue as it is; textures in flight are queued again on the next start. Stop and close lets the pipeline stop gracefully first." />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button x:Name="PauseButton" Content="Pause and close" Click="OnPauseAndClose" />
        <Button x:Name="StopButton" Content="Stop and close" Click="OnStopAndClose" Classes="accent" />
        <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" IsCancel="True" />
      </StackPanel>
    </StackPanel>
    <StackPanel x:Name="StoppingPanel" Spacing="12" IsVisible="False">
      <TextBlock Text="Stopping gracefully… the app closes when the pipeline has stopped." TextWrapping="Wrap" />
      <ProgressBar IsIndeterminate="True" Height="6" />
      <StackPanel x:Name="ForcePanel" Spacing="8" IsVisible="False">
        <TextBlock TextWrapping="Wrap" Opacity="0.8"
                   Text="The stop is taking long. Force close ends texconv and exits now; the interrupted textures are queued again on the next start." />
        <Button Content="Force close" Click="OnForceClose" HorizontalAlignment="Right" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
</Window>
